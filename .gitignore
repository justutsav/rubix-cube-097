__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Every .env variant. Same rule Rubix-Cube-90 learned the hard way: a real credential
# sat in a file called `.env.bak-s3` that was untracked but NOT ignored. Match the
# family, not the filenames somebody happened to think of.
.env
.env.*
!.env.example

# Credentials pasted in as loose files. A Supabase personal access token arrived in this
# repo as `supbase-access-token.txt` on 2026-09-26 — untracked, but nothing stopped the
# next `git add -A`. It now lives in ~/.config/rc097/ (mode 600) and never in the tree.
# Match the family, not the one filename somebody used.
*token*.txt
*token*.json
*secret*
*credential*
*.pem
*.key
!packages/**/*.key.ts
service-account*.json
supabase/.temp/
.supabase/

.DS_Store
.next/
dist/
out/
*.tsbuildinfo
next-env.d.ts

# Dev databases. A working one holds submitted source documents — which for this PS
# may be threat intel somebody pasted in. Never commit one.
*.db
*.sqlite
*.sqlite3

# Model weights. We self-host; the weights are not source.
*.gguf
*.safetensors
*.pt
*.pth
*.onnx

# Uploaded source content and everything rendered from it. Both are user material,
# both regenerate. Commit the manifest, not the corpus — see samples/README.md.
ai/.storage/
ai/.cache/
samples/raw/*
!samples/raw/.gitkeep
research/data/

# /graphify's output — a content-addressed LLM cache keyed on chunk hashes. It
# regenerates from source and goes stale the moment anyone commits.
graphify-out/

# Editor/agent scratch.
.claude/
.vercel/
*.egg-info/

# Rendered video and narration audio. ~160MB of binaries that bloat every clone
# forever and are not source. They ship as GitHub release assets instead —
# see the release page. Re-render with `npm run build` inside video/.
docs/Utsav/video/**/*.mp4
docs/Utsav/video/**/*.wav
video/public/**/*.wav
video/out/

# scripts/ivr.sh: pids, logs, test DB, tunnel URL
.run/
