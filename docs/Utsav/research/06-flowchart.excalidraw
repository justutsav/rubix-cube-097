  {
   "id": "ad3b",
   "type": "text",
   "x": 1356,
   "y": 662,
   "width": 377.3,
   "height": 175.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
