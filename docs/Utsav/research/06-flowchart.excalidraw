   "link": null,
   "locked": false,
   "text": "THE DIALECT PROBLEM, STATED HONESTLY",
   "originalText": "THE DIALECT PROBLEM, STATED HONESTLY",
   "fontSize": 19,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
