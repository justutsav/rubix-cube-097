  {
   "id": "x1b",
   "type": "text",
   "x": 76,
   "y": 3155,
   "width": 508.20000000000005,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
