   "seed": 1671721438,
   "version": 1,
   "versionNonce": 1104954584,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ONE CONTRACT — POST /v1/turn\n{ channel, channelRef, identity, utterance, localeHint }  →  { say[], expect, state, progress }\nNo channel knows what is inside. If the FSM ever moves into an adapter, WhatsApp becomes a\nsecond copy of the same seven questions and they disagree by day three.",
   "originalText": "ONE CONTRACT — POST /v1/turn\n{ channel, channelRef, identity, utterance, localeHint }  →  { say[], expect, state, progress }\nNo channel knows what is inside. If the FSM ever moves into an adapter, WhatsApp becomes a\nsecond copy of the same seven questions and they disagree by day three.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "contract",
   "lineHeight": 1.25,
   "autoResize": false
  },
