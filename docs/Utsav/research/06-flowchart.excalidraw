  {
   "id": "contract_t",
   "type": "text",
   "x": 872.0,
   "y": 990.0,
   "width": 836.0000000000001,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
