  },
  {
   "id": "sp2b",
   "type": "text",
   "x": 1316,
   "y": 1178,
   "width": 608.3000000000001,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1440165765,
   "version": 1,
   "versionNonce": 378748026,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Maithili IS covered (mai-IN) — it is Eighth Schedule.\n\nBhojpuri 5.05 cr · Rajasthani 2.58 cr · Chhattisgarhi 1.62 cr · Magahi 1.27 cr\n≈ 11 crore speakers with NO model at Sarvam, at Bhashini, or open-source.\nThey are sent to the Hindi model because there is nothing else to send them to.\n\nWe do NOT claim a dialect model. We absorb the error in the lexicon below,\nand we publish WER beside field-extraction accuracy. Dual-pass for these four:\na second call with language_code=unknown, to get a genuine alternate.",
   "originalText": "Maithili IS covered (mai-IN) — it is Eighth Schedule.\n\nBhojpuri 5.05 cr · Rajasthani 2.58 cr · Chhattisgarhi 1.62 cr · Magahi 1.27 cr\n≈ 11 crore speakers with NO model at Sarvam, at Bhashini, or open-source.\nThey are sent to the Hindi model because there is nothing else to send them to.\n\nWe do NOT claim a dialect model. We absorb the error in the lexicon below,\nand we publish WER beside field-extraction accuracy. Dual-pass for these four:\na second call with language_code=unknown, to get a genuine alternate.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
