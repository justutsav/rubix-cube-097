   "versionNonce": 1869139852,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· Audio discarded inside the turn. No recording_url column exists.\n· raw_transcript erased at CONFIRM — enforced by a DB CHECK,\n  on the server AND in the on-device SQLite schema.\n· Raw phone number never stored — only hmac(e164, pepper),\n  and the pepper never leaves the server.\n· Consent is an FSM STATE, logged with its script version,\n  withdrawable, and it names all four channels.\n· Guardian branch fires on decisional capacity, not disability.",
   "originalText": "· Audio discarded inside the turn. No recording_url column exists.\n· raw_transcript erased at CONFIRM — enforced by a DB CHECK,\n  on the server AND in the on-device SQLite schema.\n· Raw phone number never stored — only hmac(e164, pepper),\n  and the pepper never leaves the server.\n· Consent is an FSM STATE, logged with its script version,\n  withdrawable, and it names all four channels.\n· Guardian branch fires on decisional capacity, not disability.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
