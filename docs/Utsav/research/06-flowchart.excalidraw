   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "x2b",
   "type": "text",
   "x": 916,
   "y": 3155,
   "width": 408.1,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1254770554,
   "version": 1,
   "versionNonce": 80235335,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One person, one profile. Sessions are disposable.\n\nIVR Monday 11:02, drops at Q4\n  → WhatsApp Monday 18:40, resumes AT Q4\n     → kiosk Tuesday, finishes Q5-Q7\n\nConfirmed answers are immutable. Only unconfirmed\nfields are ever re-asked. Multiple people per handset\nis the NORMAL case, carried by (phone_hash, ordinal).",
   "originalText": "One person, one profile. Sessions are disposable.\n\nIVR Monday 11:02, drops at Q4\n  → WhatsApp Monday 18:40, resumes AT Q4\n     → kiosk Tuesday, finishes Q5-Q7\n\nConfirmed answers are immutable. Only unconfirmed\nfields are ever re-asked. Multiple people per handset\nis the NORMAL case, carried by (phone_hash, ordinal).",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
