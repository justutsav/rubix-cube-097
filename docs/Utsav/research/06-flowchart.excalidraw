  {
   "id": "o3_t",
   "type": "text",
   "x": 1453.3,
   "y": 2736.0,
   "width": 323.40000000000003,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
