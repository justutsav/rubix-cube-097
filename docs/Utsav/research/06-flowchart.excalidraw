   "seed": 608618322,
   "version": 1,
   "versionNonce": 2042529096,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "BASIC ISSUE 3 — PLACEMENT\noutcome: RECOMMENDED → ENROLLED →\nCERTIFIED → PLACED → DROPPED\nUpdated from the mobiliser's call list,\nNOT from a new officer screen.\nGuidelines mandate 70% placement.\nCAG measured PMKVY at 41%.\nTurns 'demand' into 'demand AND delivery'.",
   "originalText": "BASIC ISSUE 3 — PLACEMENT\noutcome: RECOMMENDED → ENROLLED →\nCERTIFIED → PLACED → DROPPED\nUpdated from the mobiliser's call list,\nNOT from a new officer screen.\nGuidelines mandate 70% placement.\nCAG measured PMKVY at 41%.\nTurns 'demand' into 'demand AND delivery'.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "o3",
   "lineHeight": 1.25,
   "autoResize": false
