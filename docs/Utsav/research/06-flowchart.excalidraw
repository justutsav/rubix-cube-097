   "frameId": null,
   "roundness": null,
   "seed": 1905558448,
   "version": 1,
   "versionNonce": 1058265613,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· Meta Cloud API DIRECT (no reseller markup)\n· Webhook → media_id → short-lived signed URL\n· Download OGG/Opus → decode → 16 kHz PCM\n· X-Hub-Signature-256 verified, else dropped\n· REPLIES AS A VOICE NOTE, never as text\n  (a text reply fails people who cannot read)\n· Prompt audio pre-uploaded once, media id reused\n· Interactive reply buttons when expect = enum\n· ONE QUESTION PER MESSAGE — batching was\n  costed at ₹0.77/head and rejected: it is a form",
   "originalText": "· Meta Cloud API DIRECT (no reseller markup)\n· Webhook → media_id → short-lived signed URL\n· Download OGG/Opus → decode → 16 kHz PCM\n· X-Hub-Signature-256 verified, else dropped\n· REPLIES AS A VOICE NOTE, never as text\n  (a text reply fails people who cannot read)\n· Prompt audio pre-uploaded once, media id reused\n· Interactive reply buttons when expect = enum\n· ONE QUESTION PER MESSAGE — batching was\n  costed at ₹0.77/head and rejected: it is a form",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
