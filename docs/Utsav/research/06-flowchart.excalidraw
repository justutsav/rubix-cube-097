   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "B1 — TO THE BENEFICIARY, SPOKEN, ≤ 60 s",
   "originalText": "B1 — TO THE BENEFICIARY, SPOKEN, ≤ 60 s",
   "fontSize": 19,
