   "versionNonce": 392212784,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The plan stays. She can open it any day.\n\n· the three options and the gap, spoken\n  again on a tap\n· what to carry: Aadhaar, caste\n  certificate, bank passbook, photo\n· nearest centre and how far\n· 'I WANT TO ENROL' → tells the worker\n· a reminder before the batch starts",
   "originalText": "The plan stays. She can open it any day.\n\n· the three options and the gap, spoken\n  again on a tap\n· what to carry: Aadhaar, caste\n  certificate, bank passbook, photo\n· nearest centre and how far\n· 'I WANT TO ENROL' → tells the worker\n· a reminder before the batch starts",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
