   "versionNonce": 557917991,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The worker updates one list on her phone:\n\nRECOMMENDED → ENROLLED → CERTIFIED\n       → PLACED     (or DROPPED, and why)\n\nNot a new officer screen — the list she\nalready works from.\n\nThis is Basic Issue 3, and the only way\nthe district learns whether any of it\nactually worked.",
   "originalText": "The worker updates one list on her phone:\n\nRECOMMENDED → ENROLLED → CERTIFIED\n       → PLACED     (or DROPPED, and why)\n\nNot a new officer screen — the list she\nalready works from.\n\nThis is Basic Issue 3, and the only way\nthe district learns whether any of it\nactually worked.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
