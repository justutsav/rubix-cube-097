   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A recommendation she cannot act on is the CAG's 41% placement figure being made one call at a time.\nThe interview ending is not the product ending — so every channel has a next step, and somebody is told to follow up.",
   "originalText": "A recommendation she cannot act on is the CAG's 41% placement figure being made one call at a time.\nThe interview ending is not the product ending — so every channel has a next step, and somebody is told to follow up.",
