   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "AND IT LOOPS BACK: a NEAR-MISS is not a rejection. 'One more year' or 'do the Level 2 course first' becomes a task on the\nworker's list too — so the same person is re-interviewed when the gap closes, instead of being counted as a failure.",
   "originalText": "AND IT LOOPS BACK: a NEAR-MISS is not a rejection. 'One more year' or 'do the Level 2 course first' becomes a task on the\nworker's list too — so the same person is re-interviewed when the gap closes, instead of being counted as a failure.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
