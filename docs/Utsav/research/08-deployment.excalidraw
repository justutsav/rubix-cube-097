   "versionNonce": 1511741589,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Row Level Security, per role:\n· a mobiliser sees only her own district\n· an officer sees only their district\n· a beneficiary never connects at all\n\nThe anon key ships inside the APK and is\nPUBLIC by design — RLS is what protects\nthe data, not that string.",
   "originalText": "Row Level Security, per role:\n· a mobiliser sees only her own district\n· an officer sees only their district\n· a beneficiary never connects at all\n\nThe anon key ships inside the APK and is\nPUBLIC by design — RLS is what protects\nthe data, not that string.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
