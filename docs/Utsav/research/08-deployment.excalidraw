  {
   "id": "ans_t",
   "type": "text",
   "x": 72,
   "y": 1785.0,
   "width": 1158.3000000000002,
   "height": 135.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1359918507,
   "version": 1,
   "versionNonce": 914405600,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "THE SERVER is the code that DECIDES — the seven questions, the extraction ladder, the eligibility gate, the ranking —\nplus the code that talks to vendors on our behalf so a key never ships in an app.\n\nTHE DATABASE is the rows that REMAIN, and the rules that refuse bad ones.\n\nThe same core runs in three places: the handset, the edge function and the VM. The database runs in exactly one.",
   "originalText": "THE SERVER is the code that DECIDES — the seven questions, the extraction ladder, the eligibility gate, the ranking —\nplus the code that talks to vendors on our behalf so a key never ships in an app.\n\nTHE DATABASE is the rows that REMAIN, and the rules that refuse bad ones.\n\nThe same core runs in three places: the handset, the edge function and the VM. The database runs in exactly one.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "ans",
   "lineHeight": 1.25,
   "autoResize": false
  },
