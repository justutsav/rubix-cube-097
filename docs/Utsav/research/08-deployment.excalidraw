   "link": null,
   "locked": false,
   "text": "THE DATABASE NEVER CALLS ANYTHING. It has no idea Sarvam or Exotel exist. It receives writes from the server, answers reads\nfrom the officer console, and rejects anything that breaks a constraint. Every decision in this system is made in tier 3 or 4.",
   "originalText": "THE DATABASE NEVER CALLS ANYTHING. It has no idea Sarvam or Exotel exist. It receives writes from the server, answers reads\nfrom the officer console, and rejects anything that breaks a constraint. Every decision in this system is made in tier 3 or 4.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "d4",
   "lineHeight": 1.25,
   "autoResize": false
  },
