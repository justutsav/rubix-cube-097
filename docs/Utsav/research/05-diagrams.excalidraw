   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Self-hosted GPU only beats Sarvam at Rs 30/hr of audio above ~47,700 four-minute interviews PER MONTH. Pilot scale is nowhere near it.",
   "originalText": "Self-hosted GPU only beats Sarvam at Rs 30/hr of audio above ~47,700 four-minute interviews PER MONTH. Pilot scale is nowhere near it.",
