   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The LLM path costs 400-1200 ms and blows the budget if it lands on the hot path.\nDefence: lexicon takes ~70% of turns; when the LLM IS invoked, play a 300 ms \"hmm...\" over it.",
   "originalText": "The LLM path costs 400-1200 ms and blows the budget if it lands on the hot path.\nDefence: lexicon takes ~70% of turns; when the LLM IS invoked, play a 300 ms \"hmm...\" over it.",
