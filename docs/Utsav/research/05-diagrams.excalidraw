    }
   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "p7n2_t",
   "type": "text",
   "x": 578.4,
   "y": 3090.0,
   "width": 783.2,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1557590252,
   "version": 1,
   "versionNonce": 1100266592,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why an FSM and not an LLM agent: every turn is replayable, every extraction is a logged\n(transcript -> value, confidence) pair, and the model can never invent an eighth question\nin front of a jury. When CAG audits this in 2029, the answer is a row, not a prompt.",
   "originalText": "Why an FSM and not an LLM agent: every turn is replayable, every extraction is a logged\n(transcript -> value, confidence) pair, and the model can never invent an eighth question\nin front of a jury. When CAG audits this in 2029, the answer is a row, not a prompt.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "p7n2",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "p7n4",
   "type": "rectangle",
   "x": 490,
   "y": 3210,
   "width": 960,
   "height": 135,
   "angle": 0,
   "strokeColor": "#06b6d4",
   "backgroundColor": "#c3fae8",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1180726494,
   "version": 1,
   "versionNonce": 1161633860,
   "isDeleted": false,
   "boundElements": [
