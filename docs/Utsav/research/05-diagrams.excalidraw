   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Multiple beneficiaries per handset is the NORMAL case in this scheme, not an edge case -\nso the data model carries it from day one instead of retrofitting a unique constraint later.",
   "originalText": "Multiple beneficiaries per handset is the NORMAL case in this scheme, not an edge case -\nso the data model carries it from day one instead of retrofitting a unique constraint later.",
   "fontSize": 16,
   "fontFamily": 2,
