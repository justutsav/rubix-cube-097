   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1 OCTOBER 2026 - service/utility messages inside the 24 h window become chargeable\nbeyond a free monthly allowance (~1,000), at Rs 0.115 each. Our cost model assumes PAID replies.\nThe free tier is ending. Payment method must be on file by 30 Sept.",
   "originalText": "1 OCTOBER 2026 - service/utility messages inside the 24 h window become chargeable\nbeyond a free monthly allowance (~1,000), at Rs 0.115 each. Our cost model assumes PAID replies.\nThe free tier is ending. Payment method must be on file by 30 Sept.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
