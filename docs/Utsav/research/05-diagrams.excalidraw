   "versionNonce": 481780382,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "We do NOT claim a Bhojpuri ASR model (~18 h of corpus exists for 4 dialects). We claim, and MEASURE,\nthat a badly transcribed Bhojpuri utterance still lands on the right CONCEPT - WER published next to\nfield-extraction accuracy. That chart is the strongest slide available.",
   "originalText": "We do NOT claim a Bhojpuri ASR model (~18 h of corpus exists for 4 dialects). We claim, and MEASURE,\nthat a badly transcribed Bhojpuri utterance still lands on the right CONCEPT - WER published next to\nfield-extraction accuracy. That chart is the strongest slide available.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
