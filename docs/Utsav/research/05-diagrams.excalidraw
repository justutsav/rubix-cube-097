   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "DEFER is why the system never hangs up on someone it cannot understand.",
   "originalText": "DEFER is why the system never hangs up on someone it cannot understand.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
