  },
  {
   "id": "p7n_t",
   "type": "text",
   "x": 648.8,
   "y": 2902.5,
   "width": 642.4000000000001,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1248525908,
   "version": 1,
   "versionNonce": 1770181519,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Q1 + Q2 are not biography - they are the eligibility inputs.\n\"I've done my father's weaving for twelve years\" is an ELIGIBILITY CLAIM:\nNSQF 2.5+ is reachable on experience alone, with no schooling, via RPL.\nThe highest-value inference in the interview.",
   "originalText": "Q1 + Q2 are not biography - they are the eligibility inputs.\n\"I've done my father's weaving for twelve years\" is an ELIGIBILITY CLAIM:\nNSQF 2.5+ is reachable on experience alone, with no schooling, via RPL.\nThe highest-value inference in the interview.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "p7n",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "p7n2",
   "type": "rectangle",
   "x": 490,
   "y": 3055,
   "width": 960,
   "height": 130,
   "angle": 0,
   "strokeColor": "#8b5cf6",
   "backgroundColor": "#d0bfff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 2053555842,
   "version": 1,
   "versionNonce": 893932060,
   "isDeleted": false,
   "boundElements": [
