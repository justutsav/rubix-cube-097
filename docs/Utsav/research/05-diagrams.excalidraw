   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Barge-in: VAD keeps running WHILE the assistant speaks. Speech detected -> send clear,\nkill the send queue, go to LISTEN. Without it, an impatient caller talks over a 4 s prompt.",
   "originalText": "Barge-in: VAD keeps running WHILE the assistant speaks. Speech detected -> send clear,\nkill the send queue, go to LISTEN. Without it, an impatient caller talks over a 4 s prompt.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "p3n2",
   "lineHeight": 1.25,
   "autoResize": false
  },
