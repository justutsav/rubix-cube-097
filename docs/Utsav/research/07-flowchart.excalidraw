   "updated": 1,
   "link": null,
   "locked": false,
   "text": "POST /v1/turn\n{ channel, channelRef, identity, utterance, localeHint }  →  { say[], expect, state, progress }\nNo channel knows what is inside. If the FSM ever moves into an adapter, WhatsApp becomes a\nsecond copy of the same seven questions and they disagree by day three.",
   "originalText": "POST /v1/turn\n{ channel, channelRef, identity, utterance, localeHint }  →  { say[], expect, state, progress }\nNo channel knows what is inside. If the FSM ever moves into an adapter, WhatsApp becomes a\nsecond copy of the same seven questions and they disagree by day three.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "contract",
   "lineHeight": 1.25,
   "autoResize": false
