   "roundness": null,
   "seed": 1576927213,
   "version": 1,
   "versionNonce": 1145294609,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every recommendation is stored with:\n   weights_version · engine_version · nqr_snapshot_sha · the inputs\n\nIn 2030 somebody will ask why this person was sent to this trade.\nThe answer has to be a ROW, not a prompt.\n\nNOTE THE DIRECTION: adapters NEVER write to the database.\nEverything passes through the core first — otherwise the gate\nand the FSM can be bypassed, and the register quietly fills\nwith ungated rows nobody can defend.",
   "originalText": "Every recommendation is stored with:\n   weights_version · engine_version · nqr_snapshot_sha · the inputs\n\nIn 2030 somebody will ask why this person was sent to this trade.\nThe answer has to be a ROW, not a prompt.\n\nNOTE THE DIRECTION: adapters NEVER write to the database.\nEverything passes through the core first — otherwise the gate\nand the FSM can be bypassed, and the register quietly fills\nwith ungated rows nobody can defend.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
