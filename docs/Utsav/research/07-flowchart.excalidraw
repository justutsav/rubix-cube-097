  },
  {
   "id": "x3_bo",
   "type": "text",
   "x": 1394.0,
   "y": 3072.0,
   "width": 321.75,
   "height": 195.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
