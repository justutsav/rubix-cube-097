  {
   "id": "ad1_bo",
   "type": "text",
   "x": 74,
   "y": 753.25,
   "width": 364.65000000000003,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2027756951,
   "version": 1,
   "versionNonce": 2038550386,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· Exotel AgentStream, bidirectional WebSocket\n· 8 kHz L16 mono PCM, base64, 20 ms frames\n· VAD endpointing — 12 silent frames = 240 ms\n· Adaptive noise floor: a village line is not a lab\n· BARGE-IN — she speaks, we send `clear`, kill\n  the send queue and go back to LISTEN\n· DTMF capture: language, yes/no, digits\n· Resample 8k → 16k (a format fix, not quality)\n· Pre-rendered WAV playback, real-time paced\n· Call drops → RESUMABLE, answers persist",
   "originalText": "· Exotel AgentStream, bidirectional WebSocket\n· 8 kHz L16 mono PCM, base64, 20 ms frames\n· VAD endpointing — 12 silent frames = 240 ms\n· Adaptive noise floor: a village line is not a lab\n· BARGE-IN — she speaks, we send `clear`, kill\n  the send queue and go back to LISTEN\n· DTMF capture: language, yes/no, digits\n· Resample 8k → 16k (a format fix, not quality)\n· Pre-rendered WAV playback, real-time paced\n· Call drops → RESUMABLE, answers persist",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
