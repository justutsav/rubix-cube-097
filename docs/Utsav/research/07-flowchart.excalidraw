  {
   "id": "c1_t",
   "type": "text",
   "x": 72,
   "y": 2132.25,
   "width": 870.1,
   "height": 35.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1166456691,
   "version": 1,
   "versionNonce": 535920383,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1.  IDENTITY & SESSION RESOLVE — phone_hash → beneficiary. Answer rows hang off beneficiary_id, NEVER session_id.\n     That one line is what lets a dropped call on Monday finish on a kiosk on Tuesday.",
   "originalText": "1.  IDENTITY & SESSION RESOLVE — phone_hash → beneficiary. Answer rows hang off beneficiary_id, NEVER session_id.\n     That one line is what lets a dropped call on Monday finish on a kiosk on Tuesday.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "c1",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "c2",
