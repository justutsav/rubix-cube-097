  },
  {
   "id": "llm_n_t",
   "type": "text",
   "x": 1062.0,
   "y": 1858.75,
   "width": 446.6,
   "height": 157.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1686380779,
   "version": 1,
   "versionNonce": 555939677,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WHAT THE LLM ACTUALLY RECEIVES\nThe transcript, and a list of options. That is all.\n\nNo name · no phone number · no district · no caste marker.\n\nOpenRouter for the common case — cheap and swappable.\nSarvam-M as the one-config-value sovereign switch, because\n“we can run this on Indian infrastructure” is a sentence\nworth being able to say in a MoSJE room.",
   "originalText": "WHAT THE LLM ACTUALLY RECEIVES\nThe transcript, and a list of options. That is all.\n\nNo name · no phone number · no district · no caste marker.\n\nOpenRouter for the common case — cheap and swappable.\nSarvam-M as the one-config-value sovereign switch, because\n“we can run this on Indian infrastructure” is a sentence\nworth being able to say in a MoSJE room.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "llm_n",
   "lineHeight": 1.25,
   "autoResize": false
  },
