   "text": "B2 — TO POSTGRES, AND THEN TO THE OFFICER",
   "originalText": "B2 — TO POSTGRES, AND THEN TO THE OFFICER",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "b2_bo",
   "type": "text",
   "x": 1064.0,
   "y": 2775.5,
   "width": 479.05,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
