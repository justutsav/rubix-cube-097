  {
   "id": "resume_t",
   "type": "text",
   "x": 72,
   "y": 531.0,
   "width": 866.2500000000001,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
