  {
   "id": "c2_ti",
   "type": "text",
   "x": 74,
   "y": 2209.25,
   "width": 519.2,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#6d28d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
