  {
   "id": "c3_ti",
   "type": "text",
   "x": 1064.0,
   "y": 2209.25,
   "width": 484.00000000000006,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#15803d",
   "backgroundColor": "transparent",
