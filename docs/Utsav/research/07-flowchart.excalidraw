  {
   "id": "x1_bo",
   "type": "text",
   "x": 74,
   "y": 3072.0,
   "width": 321.75,
   "height": 211.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
