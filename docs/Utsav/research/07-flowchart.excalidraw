   "version": 1,
   "versionNonce": 150656272,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· Audio discarded inside the turn. No\n  recording_url column exists.\n· raw_transcript erased at CONFIRM — enforced\n  by a DB CHECK, on the server AND in the\n  on-device SQLite schema.\n· Raw phone number never stored — only\n  hmac(e164, pepper), and the pepper never\n  leaves the server.\n· Consent is an FSM STATE, logged with its\n  script version, withdrawable, and it names\n  all four surfaces.\n· Guardian branch fires on decisional\n  capacity, never on disability.",
   "originalText": "· Audio discarded inside the turn. No\n  recording_url column exists.\n· raw_transcript erased at CONFIRM — enforced\n  by a DB CHECK, on the server AND in the\n  on-device SQLite schema.\n· Raw phone number never stored — only\n  hmac(e164, pepper), and the pepper never\n  leaves the server.\n· Consent is an FSM STATE, logged with its\n  script version, withdrawable, and it names\n  all four surfaces.\n· Guardian branch fires on decisional\n  capacity, never on disability.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
