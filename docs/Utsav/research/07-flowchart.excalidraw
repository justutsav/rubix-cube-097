  {
   "id": "lad_n_t",
   "type": "text",
   "x": 72,
   "y": 1858.75,
   "width": 446.6,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1451209121,
   "version": 1,
   "versionNonce": 494332572,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "STOP ON THE FIRST RUNG THAT FIRES.\nLow confidence is a RE-ASK, not an error — which is what a\nconsiderate human interviewer does anyway.\n\nconf ≥ 0.85 → confirm\n0.55 – 0.85  → explicit spoken readback\n< 0.55        → re-ask, max 2\nafter 2       → DTMF fallback, else DEFER and move on",
   "originalText": "STOP ON THE FIRST RUNG THAT FIRES.\nLow confidence is a RE-ASK, not an error — which is what a\nconsiderate human interviewer does anyway.\n\nconf ≥ 0.85 → confirm\n0.55 – 0.85  → explicit spoken readback\n< 0.55        → re-ask, max 2\nafter 2       → DTMF fallback, else DEFER and move on",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "lad_n",
   "lineHeight": 1.25,
   "autoResize": false
  },
  {
   "id": "llm_n",
