   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Aggregated confirmed demand becomes the\nstatutory artefact.\n\n· 3.5-4× the notional allocation\n· multi-year horizon\n· DL-PACC submits via the portal\n\n*** DUE THE FIRST WEEK OF APRIL ***\nDemand data arriving in July is worthless.\nThe differentiator is the FORMAT and the\nDATE, not the dashboard.",
   "originalText": "Aggregated confirmed demand becomes the\nstatutory artefact.\n\n· 3.5-4× the notional allocation\n· multi-year horizon\n· DL-PACC submits via the portal\n\n*** DUE THE FIRST WEEK OF APRIL ***\nDemand data arriving in July is worthless.\nThe differentiator is the FORMAT and the\nDATE, not the dashboard.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
