# ai/ service (or tools/stub_engine.py)
ENGINE_URL=http://localhost:8001
ENGINE_TIMEOUT_MS=1500
# HMAC secret for phone numbers; same value as ai/
PHONE_PEPPER=change-me

# Listening
VAD_AGGRESSIVENESS=2
ENDPOINT_SILENCE_MS=240
MIN_UTTERANCE_MS=250
MAX_UTTERANCE_MS=15000
BARGE_IN_SPEECH_MS=400
NO_INPUT_TIMEOUT_MS=6000
FILLER_AFTER_MS=700
MAX_CALL_SECONDS=600

# Secret on the audio stream: Exotel/softphone must connect with ?token=<this>
STREAM_TOKEN=

# Missed call -> callback (real number only)
MISSED_CALL_SECRET=
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=
# public wss URL of this adapter, e.g. wss://<tunnel>/stream
EXOTEL_STREAM_URL=
